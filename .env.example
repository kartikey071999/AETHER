# Database: AETHER_DATABASE_URL wins; otherwise plain DATABASE_URL is used.
# DATABASE_URL=postgresql://user:password@localhost:5432/postgres
# postgresql://, postgres:// and postgresql+psycopg:// are converted to postgresql+asyncpg://.
# Example DATABASE_URL (psycopg style): postgresql://user:password@localhost:5432/postgres
AETHER_DATABASE_URL=postgresql+asyncpg://aether:change-me@localhost:5432/aether
AETHER_DATA_DIR=data
AETHER_LOG_DIR=logs
AETHER_ARTIFACT_DIR=artifacts
AETHER_WORKSPACE_DIR=workspaces
AETHER_LOG_RETENTION_DAYS=30
AETHER_LOG_MAX_BYTES=10485760
AETHER_LOG_BACKUP_COUNT=5
AETHER_MAX_CONCURRENT_TASKS=2
AETHER_MAX_CONCURRENT_BUILDS=1
AETHER_MAX_CONCURRENT_LLM_REQUESTS=2
AETHER_MIN_FREE_DISK_GB=5
AETHER_TASK_TIMEOUT_SECONDS=1800
AETHER_MAX_TASK_RETRIES=3
# Persist host CPU/RAM/disk samples (minimum 1 second), including an initial startup sample.
AETHER_RESOURCE_SAMPLE_SECONDS=30
# Purge older samples at startup and daily; nonterminal tasks' linked samples are preserved.
AETHER_RESOURCE_RETENTION_DAYS=30
# Sample audit events independently of storage frequency (minimum 60 seconds).
AETHER_RESOURCE_EVENT_SECONDS=300

# Local API. Empty token disables all writes; set a private bearer token to enable them.
AETHER_API_TOKEN=
AETHER_API_HOST=127.0.0.1
AETHER_API_PORT=8000

# Security policy (default-deny). JSON lists; empty lists keep the built-in defaults.
# The running interpreter is always added to the executable allowlist at startup.
# AETHER_SECURITY_ALLOWED_EXECUTABLES=["/usr/bin/git"]
# AETHER_SECURITY_ALLOWED_HOSTS=["api.example.com"]
# AETHER_SECURITY_EXTRA_FILESYSTEM_ROOTS=["/srv/aether-shared"]
# AETHER_SECURITY_APPROVAL_REQUIRED_KINDS=["subprocess","http_request","package_install","repo_clone","config_change","credential_access","network_scan"]
# AETHER_SECURITY_USER_AUTHORIZATION_REQUIRED_KINDS=["config_change","credential_access","network_scan"]
AETHER_SECURITY_MAX_APPROVAL_TTL_SECONDS=3600
AETHER_SECURITY_AUTHORIZATION_TTL_SECONDS=60
AETHER_SECURITY_SUBPROCESS_TIMEOUT_SECONDS=300
AETHER_SECURITY_MAX_OUTPUT_BYTES=1048576
AETHER_SECURITY_HTTP_TIMEOUT_SECONDS=30
AETHER_SECURITY_MAX_RESPONSE_BYTES=5242880
AETHER_SECURITY_MAX_REDIRECTS=5

# Web research tools for SCOUT/ROGUE (docs/web-research.md). web_fetch operations may only reach
# this separate allowlist (JSON list; "*." matches subdomains), never AETHER_SECURITY_ALLOWED_HOSTS.
# AETHER_WEB_ALLOWED_HOSTS=["pypi.org","api.github.com","github.com","docs.python.org","readthedocs.io","*.readthedocs.io"]
# Hosts docs.search may query (each must also be allowed above):
# AETHER_WEB_DOCS_HOSTS=["docs.python.org","*.readthedocs.io"]
AETHER_WEB_TIMEOUT_SECONDS=20
AETHER_WEB_MAX_PAGE_BYTES=2097152
# Disk cache under data_dir/web_cache/ (0 disables) and robots.txt cache lifetime:
AETHER_WEB_CACHE_TTL_SECONDS=21600
AETHER_WEB_ROBOTS_TTL_SECONDS=86400
# Minimum spacing per host (robots.txt Crawl-delay can raise it) and global concurrency:
AETHER_WEB_PER_HOST_INTERVAL_SECONDS=1.0
AETHER_WEB_MAX_CONCURRENCY=4
AETHER_WEB_MAX_CRAWL_PAGES=10
AETHER_WEB_MAX_CRAWL_DEPTH=2

# Agent runtime: periodic agent hooks and cooperative task control (pause/cancel).
AETHER_AGENT_TICK_SECONDS=30
# Per-agent tick interval overrides, a JSON object keyed by agent id:
# AETHER_AGENT_TICK_OVERRIDES={"WARDEN": 5}
AETHER_AGENT_TICK_TIMEOUT_SECONDS=120
AETHER_TASK_CONTROL_POLL_SECONDS=5
AETHER_TASK_INTERRUPT_GRACE_SECONDS=10

# ORCHESTR limits. Set a whole object as JSON (AETHER_ORCHESTR={"max_active_objectives": 5})
# or individual keys with the double-underscore form below.
AETHER_ORCHESTR__MAX_ACTIVE_OBJECTIVES=10
AETHER_ORCHESTR__MAX_GENERATED_OBJECTIVES_PER_INTERVAL=3
AETHER_ORCHESTR__GENERATED_INTERVAL_HOURS=24
AETHER_ORCHESTR__MAX_GENERATED_PRIORITY=60
AETHER_ORCHESTR__LIMIT_DEFERRAL_HOURS=1
AETHER_ORCHESTR__MAX_TASKS_PER_OBJECTIVE=30
AETHER_ORCHESTR__MAX_SUBTASK_DEPTH=3
AETHER_ORCHESTR__MAX_PLAN_DEPTH=8
AETHER_ORCHESTR__MAX_REFINEMENT_TASKS=5
AETHER_ORCHESTR__MAX_TASK_ATTEMPTS=3
AETHER_ORCHESTR__MAX_BLOCKER_ATTEMPTS=3
AETHER_ORCHESTR__MAX_REPLANS_PER_OBJECTIVE=2
AETHER_ORCHESTR__MAX_AGENT_BOOST_POINTS=15
AETHER_ORCHESTR__LLM_REFINEMENT=true
# FORGE: ask the LLM first even for known capability templates (the template stays the fallback).
AETHER_FORGE_LLM_REFINE_TEMPLATES=false
AETHER_ORCHESTR__DEADLINE_ESCALATION_HOURS=24
# At most one escalation + user update per (objective, kind) within this window; later ones aggregate.
AETHER_ORCHESTR__ESCALATION_WINDOW_HOURS=1
# A FORGE task held for an approved requirement escalates the objective after this many minutes.
AETHER_ORCHESTR__REQUIREMENT_WAIT_MINUTES=10
# A task waiting for its independent test run, for an approval, or deferred for resources
# escalates once (without blocking the objective) after this many minutes.
AETHER_ORCHESTR__VERIFICATION_WAIT_MINUTES=30
AETHER_ORCHESTR__APPROVAL_WAIT_MINUTES=60
AETHER_ORCHESTR__RESOURCE_DEFERRAL_MINUTES=15
# Resource pressure: ORCHESTR may pause interruptible running tasks after this many consecutive
# pressured ticks (0 pauses per tick disables it) and resumes them after this many calm ticks.
# Pressure means CPU above the scheduler limit, free disk below the reserve, or available RAM
# below the minimum set here.
AETHER_ORCHESTR__PRESSURE_PAUSE_AFTER_TICKS=3
AETHER_ORCHESTR__PRESSURE_RESUME_AFTER_TICKS=2
AETHER_ORCHESTR__PRESSURE_MAX_PAUSES_PER_TICK=1
AETHER_ORCHESTR__PRESSURE_MIN_AVAILABLE_RAM_MB=512
# Priority scoring policy.
AETHER_ORCHESTR__PRIORITY__DECAY_HALF_LIFE_HOURS=72
AETHER_ORCHESTR__PRIORITY__RETENTION_FLOOR=0.25
AETHER_ORCHESTR__PRIORITY__AGING_POINTS_PER_HOUR=0.05
AETHER_ORCHESTR__PRIORITY__MAX_AGING_POINTS=8
AETHER_ORCHESTR__PRIORITY__MAX_URGENCY_POINTS=30
AETHER_ORCHESTR__PRIORITY__URGENCY_HORIZON_HOURS=72
AETHER_ORCHESTR__PRIORITY__MAX_CRITICALITY_POINTS=10
AETHER_ORCHESTR__PRIORITY__MAX_BENEFIT_POINTS=8
AETHER_ORCHESTR__PRIORITY__MAX_COST_PENALTY=10
AETHER_ORCHESTR__PRIORITY__BOOST_HALF_LIFE_HOURS=24
AETHER_ORCHESTR__PRIORITY__MAX_BOOST_POINTS=40
AETHER_ORCHESTR__PRIORITY__MIN_EFFECTIVE_PRIORITY=1
AETHER_ORCHESTR__PRIORITY__MIN_CHANGE_TO_PERSIST=2

# MUSE suppresses a notice identical (audience, objective, notice kind, content) to one sent
# within this many minutes, recording communication.suppressed. 0 disables suppression.
AETHER_MUSE_DEDUPE_WINDOW_MINUTES=60

# SCOUT research limits (same JSON / double-underscore forms as ORCHESTR).
AETHER_RESEARCH__MAX_ACTIVE_OBJECTIVES=8
AETHER_RESEARCH__MAX_QUEUE_SIZE=16
AETHER_RESEARCH__MAX_GENERATED_PER_INTERVAL=2
AETHER_RESEARCH__GENERATION_INTERVAL_SECONDS=86400
AETHER_RESEARCH__REVIEW_SECONDS=86400
AETHER_RESEARCH__MAX_SOURCES=4
AETHER_RESEARCH__MAX_LLM_REQUESTS=2
# Share of ROGUE's LLM budget reserved for critique (0-1); the rest is for generating alternatives:
AETHER_RESEARCH__LLM_CRITIQUE_SHARE=0.5
AETHER_RESEARCH__MAX_ATTEMPTS=2
AETHER_RESEARCH__MAX_FOLLOW_UPS=1
AETHER_RESEARCH__TOP_K=3
# Sources researched when a request names none, a JSON list of {kind, location, purpose, perspective}:
# AETHER_RESEARCH__DEFAULT_SOURCES=[{"kind":"http","location":"https://docs.example.com/guide"}]
# Opt-in: with no scoped/default sources, derive a docs search and a GitHub repository search from
# the question (web_fetch only); ROGUE follows up on up to WEB_FOLLOW_UPS repositories.
AETHER_RESEARCH__WEB_RESEARCH=false
AETHER_RESEARCH__DOCS_BASE_URL=https://docs.python.org/3/
AETHER_RESEARCH__WEB_FOLLOW_UPS=1

# Optional model providers. Missing/empty credentials make the provider unavailable.
GROQ_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPEN_AI_KEY=
OPENAI_API_VERSION=
ANTHROPIC_ENDPOINT=
ANTHROPIC_API_KEY=
API_VERSION=
OLLAMA_BASE_URL=http://localhost:11434
# Explicit installed-model suitability; absent models are skipped. JSON object:
AETHER_PROVIDER_OLLAMA_MODELS={}
# Set to 1 to use only the offline mock provider (no network, no credentials).
# AETHER_PROVIDER_MOCK=1
# Optional price overrides per provider/model (USD per million tokens):
# AETHER_PROVIDER_PRICES={"groq/openai/gpt-oss-120b":{"input_per_mtok":0.15,"output_per_mtok":0.60}}
AETHER_PROVIDER_TIMEOUT_SECONDS=30
AETHER_PROVIDER_MAX_RETRIES=2
AETHER_PROVIDER_RETRY_BACKOFF_SECONDS=0.5
AETHER_PROVIDER_RETRY_MAX_DELAY_SECONDS=8
# Fallback fan-out and the single same-model retry for length-truncated output.
AETHER_PROVIDER_MAX_MODELS_PER_REQUEST=2
AETHER_PROVIDER_LENGTH_RETRY_MAX_TOKENS=8192
# Consecutive failed LLM calls per objective and agent before LLM use stops (0 disables).
AETHER_PROVIDER_CIRCUIT_BREAKER_FAILURES=5
# Seconds before an open breaker lets ONE probe call through (success closes, failure re-opens).
AETHER_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
# Per-objective, per-agent LLM allowances (agent id or "default"; unlisted keep defaults).
# Usage and breaker state are durable: they survive restarts (seeded from provider_usage/events).
# AETHER_PROVIDER_AGENT_BUDGETS={"FORGE":{"max_tokens_per_objective":20000,"max_requests_per_objective":8}}
# Optional JSON overrides; unspecified provider fields retain conservative defaults.
# AETHER_PROVIDER_BUDGETS={"groq":{"max_requests_per_day":2000,"max_tokens_per_day":2000000},"azure_openai":{"max_requests_per_day":50,"max_tokens_per_day":100000}}
# Additional model caps, keyed by provider/model:
# AETHER_PROVIDER_MODEL_BUDGETS={"groq/openai/gpt-oss-120b":{"max_requests_per_day":500}}
# Configured provider hosts are merged into the security allowlist at startup (runtime and
# `aether security show`); AETHER_SECURITY_ALLOWED_HOSTS only adds further hosts.