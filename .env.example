# Database: AETHER_DATABASE_URL wins; otherwise plain DATABASE_URL is used.
# postgresql://, postgres:// and postgresql+psycopg:// are converted to postgresql+asyncpg://.
# Example DATABASE_URL (psycopg style): postgresql://user:password@localhost:5432/postgres
AETHER_DATABASE_URL=postgresql+asyncpg://aether:change-me@localhost:5432/aether
AETHER_DATA_DIR=data
AETHER_LOG_DIR=logs
AETHER_ARTIFACT_DIR=artifacts
AETHER_WORKSPACE_DIR=workspaces
AETHER_LOG_RETENTION_DAYS=30
AETHER_LOG_MAX_BYTES=10485760
AETHER_LOG_BACKUP_COUNT=5
AETHER_MAX_CONCURRENT_TASKS=2
AETHER_MAX_CONCURRENT_BUILDS=1
AETHER_MAX_CONCURRENT_LLM_REQUESTS=2
AETHER_MIN_FREE_DISK_GB=5
AETHER_TASK_TIMEOUT_SECONDS=1800
AETHER_MAX_TASK_RETRIES=3